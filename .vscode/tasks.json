{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "shell",
            "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "cmake --build build --parallel",
            "dependsOn": "CMake: configure",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run AutoService",
            "type": "shell",
            "command": "${workspaceFolder}/build/AutoService",
            "dependsOn": "CMake: build",
            "problemMatcher": []
        }
    ]
}
